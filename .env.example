# 复制为 .env 后填自己的 key。.env 已在 .gitignore 里，不会被提交。

# ---- 上游模型（统一 OpenAI 协议）----
# 智谱 BigModel。glm-4.5-airx 是轻量付费档，价格低且限流宽松
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5-airx
LLM_API_KEY=填你的智谱key

# 同端点换档，只改模型名：
# LLM_MODEL=glm-4.7-flash      免费档，限流很严，只适合试玩
# LLM_MODEL=glm-4-flashx-250414 极便宜（¥0.1/¥0.1）但模型代次较旧
# LLM_MODEL=glm-4.7            高智能档，效果最好也最贵

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# OpenAI 官方
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 本地 Ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# 注意：Anthropic 官方 API 不是 OpenAI 协议，直连接不了。
# 要走 one-api / LiteLLM 之类网关转一层，才能填在这里。

# 智谱专用：深度思考开关。留空则不发送该参数（非智谱上游必须留空）。
# 必须 disabled —— langchain-openai 不解析 GLM 的 reasoning_content，
# 开启后流式会先静默一段时间才吐正文，看起来像卡死。
LLM_THINKING=disabled

LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# 显式代理，例如 http://127.0.0.1:7890。
# 留空表示不读环境里的 http_proxy/https_proxy —— 默认行为，更可预测。
# 设了这条才会走代理；服务进程继承到过期代理端口时，会表现为 "Connection error."
LLM_PROXY=

# ---- 上下文预算 ----
HISTORY_MAX_TOKENS=1500

# ---- 结构化输出方式 ----
# function_calling 兼容性最好（智谱 / DeepSeek 都支持）
# json_schema 需要上游支持 response_format=json_schema（OpenAI 支持，GLM 不一定）
STRUCTURED_METHOD=function_calling

SHOP_NAME=小店
